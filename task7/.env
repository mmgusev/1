# PostgreSQL application credentials (used by Flask to connect)
DB_USER=app_user
DB_PASS=app_pass_ChangeMe!

# Flask session secret – change this to a long random string in production!
SECRET_KEY=replace-with-a-long-random-secret-key-in-production

# Path inside the container where failed-login attempts are logged
DUPLICATE_LOG_FILE=/var/log/shop_app.log
